{
  "name": "sgla-backend",
  "version": "1.0.0",
  "description": "Backend da aplicação SGLA - Sistsema de Gerenciamento de Ligas Acadêmicas",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "env-cmd -f .env.development nodemon --watch src src/index.js",
    "dev:vercel": "npx --yes vercel dev --listen 3000",
    "prod": "env-cmd -f .env.production node src/index.js",
    "start": "node src/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint --fix ."
  },
  "dependencies": {
